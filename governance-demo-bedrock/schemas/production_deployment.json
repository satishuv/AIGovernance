{
  "openapi": "3.0.0",
  "info": {
    "title": "ProductionDeployment Action Group",
    "version": "1.0.0",
    "description": "Operations for deploying builds to production and rolling back deployments."
  },
  "paths": {
    "/deployToProduction": {
      "post": {
        "summary": "Deploy a build to the production environment",
        "description": "Initiates a deployment of the specified build to the production environment and records the deployment details.",
        "operationId": "deployToProduction",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "buildId": {
                    "type": "string",
                    "description": "The unique identifier of the build to deploy to production"
                  }
                },
                "required": ["buildId"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Deployment to production initiated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "buildId": { "type": "string", "description": "The build identifier" },
                    "environment": { "type": "string", "description": "Target environment" },
                    "status": { "type": "string", "description": "Deployment status" },
                    "message": { "type": "string", "description": "Human readable message" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/rollbackDeployment": {
      "post": {
        "summary": "Rollback a production deployment",
        "description": "Initiates a rollback of the specified build in production to the specified target build ID.",
        "operationId": "rollbackDeployment",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "buildId": {
                    "type": "string",
                    "description": "The unique identifier of the current build to rollback from"
                  },
                  "rollbackTargetBuildId": {
                    "type": "string",
                    "description": "The unique identifier of the build to rollback to"
                  }
                },
                "required": ["buildId", "rollbackTargetBuildId"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Rollback initiated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "buildId": { "type": "string", "description": "The build identifier" },
                    "rollbackTargetBuildId": { "type": "string", "description": "Target build for rollback" },
                    "status": { "type": "string", "description": "Rollback status" },
                    "message": { "type": "string", "description": "Human readable message" }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}