{
  "name": "governance-pipeline",
  "type": "EXPRESS",
  "status": "ACTIVE",
  "definition": {
    "Comment": "AIGovernance Pipeline - Scalable Step Functions Express Workflow",
    "StartAt": "KillSwitchCheck",
    "States": {
      "KillSwitchCheck": {
        "Type": "Task",
        "Resource": "arn:aws:states:::dynamodb:getItem",
        "Parameters": {
          "TableName": "GovernanceBedrockStack-ScopeTableA04A8CF8-3RBNRHY229WG",
          "Key": {
            "agent_id": {
              "S.$": "$.agent_id"
            }
          }
        },
        "ResultPath": "$.kill_switch_result",
        "Next": "CheckKillSwitchActive",
        "Catch": [
          {
            "ErrorEquals": [
              "States.ALL"
            ],
            "Next": "DenyFailSafe",
            "ResultPath": "$.error"
          }
        ]
      },
      "CheckKillSwitchActive": {
        "Type": "Choice",
        "Choices": [
          {
            "Variable": "$.kill_switch_result.Item.scope_level.N",
            "StringEquals": "0",
            "Next": "DenyKillSwitch"
          }
        ],
        "Default": "ParallelDefenseChecks"
      },
      "DenyKillSwitch": {
        "Type": "Pass",
        "Result": {
          "verdict": "deny",
          "error_category": "kill_switch_active",
          "explanation": "Kill switch is active. All requests are denied."
        },
        "End": true
      },
      "DenyFailSafe": {
        "Type": "Pass",
        "Result": {
          "verdict": "deny",
          "error_category": "infrastructure_unavailable",
          "explanation": "Governance infrastructure unavailable. Request denied as fail-safe."
        },
        "End": true
      },
      "ParallelDefenseChecks": {
        "Type": "Parallel",
        "Branches": [
          {
            "StartAt": "InputDefense",
            "States": {
              "InputDefense": {
                "Type": "Task",
                "Resource": "arn:aws:states:::lambda:invoke",
                "Parameters": {
                  "FunctionName": "arn:aws:lambda:us-east-1:917914785227:function:GovernanceBedrockStack-InputDefenseLambda4E8E7CC3-zLuAVQGtwbUw",
                  "Payload.$": "$"
                },
                "ResultSelector": {
                  "passed.$": "$.Payload.passed",
                  "verdict.$": "$.Payload.verdict",
                  "error_category.$": "$.Payload.error_category",
                  "explanation.$": "$.Payload.explanation",
                  "sanitized_text.$": "$.Payload.sanitized_text",
                  "risk_score_adjustment.$": "$.Payload.risk_score_adjustment"
                },
                "End": true
              }
            }
          },
          {
            "StartAt": "Authorization",
            "States": {
              "Authorization": {
                "Type": "Task",
                "Resource": "arn:aws:states:::lambda:invoke",
                "Parameters": {
                  "FunctionName": "arn:aws:lambda:us-east-1:917914785227:function:GovernanceBedrockStack-AuthorizationLambda1CEF3A13-WVRdOJ9BkbVn",
                  "Payload.$": "$"
                },
                "ResultSelector": {
                  "passed.$": "$.Payload.passed",
                  "verdict.$": "$.Payload.verdict",
                  "error_category.$": "$.Payload.error_category",
                  "explanation.$": "$.Payload.explanation",
                  "agent_environment.$": "$.Payload.agent_environment"
                },
                "End": true
              }
            }
          }
        ],
        "ResultPath": "$.parallel_results",
        "Next": "CheckParallelResults"
      },
      "CheckParallelResults": {
        "Type": "Choice",
        "Choices": [
          {
            "Variable": "$.parallel_results[0].passed",
            "BooleanEquals": false,
            "Next": "DenyFromInputDefense"
          },
          {
            "Variable": "$.parallel_results[1].passed",
            "BooleanEquals": false,
            "Next": "DenyFromAuthorization"
          }
        ],
        "Default": "PolicyRiskDecision"
      },
      "DenyFromInputDefense": {
        "Type": "Pass",
        "Parameters": {
          "verdict": "deny",
          "error_category.$": "$.parallel_results[0].error_category",
          "explanation.$": "$.parallel_results[0].explanation",
          "agent_id.$": "$.agent_id"
        },
        "End": true
      },
      "DenyFromAuthorization": {
        "Type": "Pass",
        "Parameters": {
          "verdict": "deny",
          "error_category.$": "$.parallel_results[1].error_category",
          "explanation.$": "$.parallel_results[1].explanation",
          "agent_id.$": "$.agent_id"
        },
        "End": true
      },
      "PolicyRiskDecision": {
        "Type": "Task",
        "Resource": "arn:aws:states:::lambda:invoke",
        "Parameters": {
          "FunctionName": "arn:aws:lambda:us-east-1:917914785227:function:GovernanceBedrockStack-PolicyRiskLambda1F0C8F21-GkyD1nBHFVFv",
          "Payload": {
            "agent_id.$": "$.agent_id",
            "action_group.$": "$.action_group",
            "target_resource.$": "$.target_resource",
            "input_text.$": "$.input_text",
            "scope_level.$": "$.scope_level",
            "sanitized_text.$": "$.parallel_results[0].sanitized_text",
            "risk_score_adjustment.$": "$.parallel_results[0].risk_score_adjustment",
            "agent_environment.$": "$.parallel_results[1].agent_environment"
          }
        },
        "ResultSelector": {
          "decision_id.$": "$.Payload.decision_id",
          "agent_id.$": "$.Payload.agent_id",
          "action_requested.$": "$.Payload.action_requested",
          "verdict.$": "$.Payload.verdict",
          "risk_score.$": "$.Payload.risk_score",
          "explanation.$": "$.Payload.explanation",
          "policy_result.$": "$.Payload.policy_result",
          "framework_mapping.$": "$.Payload.framework_mapping",
          "timestamp.$": "$.Payload.timestamp"
        },
        "ResultPath": "$.decision",
        "Next": "FireAsyncPostProcessing"
      },
      "FireAsyncPostProcessing": {
        "Type": "Task",
        "Resource": "arn:aws:states:::events:putEvents",
        "Parameters": {
          "Entries": [
            {
              "Source": "governance.pipeline",
              "DetailType": "GovernanceDecision",
              "Detail": {
                "decision_id.$": "$.decision.decision_id",
                "agent_id.$": "$.decision.agent_id",
                "action_requested.$": "$.decision.action_requested",
                "verdict.$": "$.decision.verdict",
                "risk_score.$": "$.decision.risk_score",
                "policy_result.$": "$.decision.policy_result",
                "timestamp.$": "$.decision.timestamp"
              }
            }
          ]
        },
        "ResultPath": null,
        "Next": "ReturnDecision"
      },
      "ReturnDecision": {
        "Type": "Pass",
        "Parameters": {
          "decision_id.$": "$.decision.decision_id",
          "agent_id.$": "$.decision.agent_id",
          "action_requested.$": "$.decision.action_requested",
          "verdict.$": "$.decision.verdict",
          "risk_score.$": "$.decision.risk_score",
          "explanation.$": "$.decision.explanation",
          "policy_result.$": "$.decision.policy_result",
          "framework_mapping.$": "$.decision.framework_mapping",
          "timestamp.$": "$.decision.timestamp"
        },
        "End": true
      }
    }
  },
  "role_arn": "arn:aws:iam::917914785227:role/GovernanceBedrockStack-GovernancePipelineRole51D7BF-ftsCJZpoeth2",
  "tracing": {
    "enabled": true
  }
}