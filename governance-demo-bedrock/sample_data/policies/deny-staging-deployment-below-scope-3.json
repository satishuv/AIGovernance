{
  "rule_name": "deny_staging_below_scope_3",
  "description": "Deny StagingDeployment for agents below scope 3. Staging deploys require scope 3 or higher.",
  "outcome": "deny",
  "priority": 12,
  "category": "preventive",
  "conditions": [
    {"field": "input.action_group", "op": "==", "value": "StagingDeployment"},
    {"field": "input.scope_level", "op": "<", "value": 3}
  ]
}
