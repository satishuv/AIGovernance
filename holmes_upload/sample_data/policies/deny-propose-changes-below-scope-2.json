{
  "rule_name": "deny_propose_below_scope_2",
  "description": "Deny ProposeChanges for agents below scope 2. Proposing changes requires elevated trust.",
  "outcome": "deny",
  "priority": 15,
  "category": "preventive",
  "conditions": [
    {"field": "input.action_group", "op": "==", "value": "ProposeChanges"},
    {"field": "input.scope_level", "op": "<", "value": 2}
  ]
}
