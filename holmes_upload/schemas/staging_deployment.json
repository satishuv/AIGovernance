{
  "openapi": "3.0.0",
  "info": {
    "title": "StagingDeployment Action Group",
    "version": "1.0.0",
    "description": "Operations for deploying builds to staging and triggering integration tests."
  },
  "paths": {
    "/deployToStaging": {
      "post": {
        "summary": "Deploy a build to the staging environment",
        "description": "Initiates a deployment of the specified build to the staging environment and records the deployment details.",
        "operationId": "deployToStaging",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "buildId": {
                    "type": "string",
                    "description": "The unique identifier of the build to deploy to staging"
                  }
                },
                "required": ["buildId"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Deployment to staging initiated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "buildId": { "type": "string", "description": "The build identifier" },
                    "environment": { "type": "string", "description": "Target environment" },
                    "status": { "type": "string", "description": "Deployment status" },
                    "message": { "type": "string", "description": "Human readable message" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/triggerTests": {
      "post": {
        "summary": "Trigger a test suite for a build",
        "description": "Triggers execution of the specified test suite against the specified build and records the test run details.",
        "operationId": "triggerTests",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "buildId": {
                    "type": "string",
                    "description": "The unique identifier of the build to test"
                  },
                  "testSuite": {
                    "type": "string",
                    "description": "The name of the test suite to execute (e.g. integration, smoke)"
                  }
                },
                "required": ["buildId", "testSuite"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Test suite triggered successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "buildId": { "type": "string", "description": "The build identifier" },
                    "testSuite": { "type": "string", "description": "Test suite name" },
                    "status": { "type": "string", "description": "Test run status" },
                    "message": { "type": "string", "description": "Human readable message" }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}